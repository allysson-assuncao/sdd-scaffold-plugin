{
  "sdd-readonly-auto-allow": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "view_file|read_file|grep_search|find_by_name|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/sdd-readonly-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sdd-enforce-proposal": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "write_to_file|write_file|replace_file_content|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-approved-proposal.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sdd-scope-prompt-writes": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "write_to_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/scope-prompt-writes.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sdd-run-linter": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "write_to_file|write_file|replace_file_content|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/run-linter.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
